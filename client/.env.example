# ===============================================
# MARBLEX CLIENT ENV — copy to .env or .env.local
# Vite only exposes vars prefixed with VITE_
# ===============================================

# Live API base URL (must end with /api)
# Example: https://marblex-api.onrender.com/api
VITE_API_BASE_URL=http://localhost:5000/api

# Google Sign-In (same Web Client ID as server GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com

# Optional fallbacks if /orders/payment-config is slow/unavailable
# Prefer setting real values on the SERVER .env — cart loads from API.
VITE_WHATSAPP_NUMBER=923084585792

VITE_EASYPAISA_TITLE=MARBLEX CHEMICAL & RUBBER
VITE_EASYPAISA_NUMBER=03XXXXXXXXX

VITE_JAZZCASH_TITLE=MARBLEX CHEMICAL & RUBBER
VITE_JAZZCASH_NUMBER=03XXXXXXXXX

VITE_BANK_NAME=Meezan Bank Limited
VITE_BANK_TITLE=MARBLEX CHEMICAL & RUBBER INDUSTRY
VITE_BANK_ACCOUNT=XXXXXXXXXXXXXXXX
VITE_BANK_IBAN=PK00MEZN0000000000000000
VITE_BANK_BRANCH=Your Branch, City
