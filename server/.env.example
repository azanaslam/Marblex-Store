# ===============================================
# MARBLEX PRODUCTION & DEVELOPMENT ENV TEMPLATE
# ===============================================

PORT=10000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/marblex?retryWrites=true&w=majority
JWT_SECRET=your_ultra_secure_jwt_secret_key_here

# -----------------------------------------------
# OPTION 1: BREVO (SENDINBLUE) HTTP API (RECOMMENDED FOR RENDER CLOUD)
# Free 300 emails/day, sent over HTTPS (Port 443), NEVER blocked by cloud firewalls!
# -----------------------------------------------
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDER_EMAIL=Marblexpak@gmail.com

# -----------------------------------------------
# OPTION 2: GMAIL SMTP (BACKUP / LOCAL DEVELOPMENT)
# Uses Port 587 STARTTLS with IPv4
# -----------------------------------------------
SMTP_USER=Marblexpak@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# -----------------------------------------------
# APP URLS & THIRD PARTY SERVICES
# -----------------------------------------------
FRONTEND_URL=https://marblex-shop.vercel.app
ADMIN_EMAIL=admin@marblex.com
ADMIN_PASSWORD=admin123
WHATSAPP_NUMBER=923084585792

# CLOUDINARY (MEDIA ASSETS)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# STRIPE PAYMENTS (OPTIONAL)
STRIPE_SECRET_KEY=sk_test_...

# -----------------------------------------------
# GOOGLE SIGN-IN (Google Identity Services)
# 1) https://console.cloud.google.com/apis/credentials
# 2) Create OAuth client ID → Application type: Web application
# 3) Authorized JavaScript origins:
#      http://localhost:5173
#      https://your-frontend-domain.com
# 4) Paste the Client ID below (same value on Vercel as VITE_GOOGLE_CLIENT_ID)
# -----------------------------------------------
GOOGLE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com
