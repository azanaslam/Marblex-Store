# ===============================================
# MARBLEX SERVER ENV — copy to .env and fill values
# ===============================================

PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/marblex?retryWrites=true&w=majority

# MUST change before live (long random string)
JWT_SECRET=replace_with_long_random_secret_min_32_chars

# -----------------------------------------------
# ADMIN BOOTSTRAP (first login / seed)
# -----------------------------------------------
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_me_strong_password

# Comma-separated allowed frontends (CORS + Stripe return URLs)
# Example: https://www.marblex.com,https://marblex-shop.vercel.app
FRONTEND_URL=https://your-frontend-domain.com

WHATSAPP_NUMBER=923084585792

# -----------------------------------------------
# EMAIL — Brevo recommended on Render / cloud
# -----------------------------------------------
BREVO_API_KEY=xkeysib-xxxxxxxx
SENDER_EMAIL=orders@yourdomain.com
SENDER_NAME=MARBLEX

# Optional Gmail SMTP backup (App Password)
SMTP_USER=
SMTP_PASS=
EMAIL_USER=
EMAIL_PASS=

# -----------------------------------------------
# CLOUDINARY (product images + payment proof uploads)
# -----------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------
# STRIPE (Card / online checkout)
# Dashboard → Developers → API keys
# Live: sk_live_...   Test: sk_test_...
# -----------------------------------------------
STRIPE_SECRET_KEY=sk_live_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
# PKR requires Stripe account support; otherwise use usd and convert
STRIPE_CURRENCY=pkr

# Stripe webhook endpoint (add in Stripe Dashboard → Webhooks):
#   POST https://YOUR-API-DOMAIN/api/orders/stripe-webhook
# Event: checkout.session.completed

# -----------------------------------------------
# MANUAL PAYMENTS (shown to customers on checkout)
# Fill real account details before going live
# -----------------------------------------------
EASYPAISA_TITLE=MARBLEX CHEMICAL & RUBBER
EASYPAISA_NUMBER=03XXXXXXXXX

JAZZCASH_TITLE=MARBLEX CHEMICAL & RUBBER
JAZZCASH_NUMBER=03XXXXXXXXX

BANK_NAME=Meezan Bank Limited
BANK_ACCOUNT_TITLE=MARBLEX CHEMICAL & RUBBER INDUSTRY
BANK_ACCOUNT_NUMBER=XXXXXXXXXXXXXXXX
BANK_IBAN=PK00MEZN0000000000000000
BANK_BRANCH=Your Branch, City

# -----------------------------------------------
# GOOGLE SIGN-IN (Web Client ID)
# Same value as client VITE_GOOGLE_CLIENT_ID
# -----------------------------------------------
GOOGLE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com
